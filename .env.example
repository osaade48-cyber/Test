# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# From https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered (your inbox).
ENQUIRY_TO_EMAIL=you@example.com.au

# Sender address. Must be on a domain you have verified in Resend.
# Until your domain is verified you can use: MAISON CANINE <onboarding@resend.dev>
# (Resend only delivers onboarding@resend.dev mail to your own account email.)
ENQUIRY_FROM_EMAIL="MAISON CANINE <enquiries@yourdomain.com.au>"

# Optional: also send the customer a short confirmation email (true/false).
# Needs a verified domain in ENQUIRY_FROM_EMAIL.
SEND_CUSTOMER_CONFIRMATION=false

# Public site URL, used for share links and metadata.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com.au
