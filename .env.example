# Copy to .env.local and fill in when the real backend exists.
# Never commit real values.

# Base URL of the Kindo API. Leave empty to use the in-browser mock service layer.
VITE_API_URL=

# TODO(auth): Google OAuth client ID used by services/auth.ts
VITE_GOOGLE_CLIENT_ID=

# TODO(stripe): Stripe publishable key (pk_live_… / pk_test_…) used by services/payments.ts
VITE_STRIPE_PUBLISHABLE_KEY=

# Public site URL, used for share links and meta tags
VITE_PUBLIC_SITE_URL=

# Optional: maps / geocoding provider key for suburb-level distance
VITE_MAPS_API_KEY=
